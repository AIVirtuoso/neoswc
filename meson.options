option('xwayland', type: 'feature', value: 'auto', description: 'Automatic Xwayland handling')
option('input', type: 'combo', value: 'auto', choices: ['auto', 'libinput', 'evdev', 'wscons'], description: 'Input backend to use')
option('udev', type: 'feature', value: 'auto', description: 'libinput libudev support')
option('evdev-keyboard', type: 'string', value: '/dev/input/event0', description: 'evdev keyboard device to use')
option('evdev-pointer', type: 'string', value: '/dev/input/event1', description: 'evdev pointer device to use')
option('extra', type: 'boolean', value: true, description: 'Build swc utility applications')
option('example', type: 'boolean', value: false, description: 'Build swc example compositor')
